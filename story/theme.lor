// theme.lor -- runtime presentation config for the canvas UI.
//
// Read once at startup by drift.model.ConfigLoader, before the renderer boots.
// Everything below the `state` block lands in a single top-level `theme` object;
// the typed Haxe side (drift.model.Theme) maps the keys it knows and falls back
// to its built-in defaults for anything missing or malformed.
//
// This file covers the canvas UI (the dialogue box and its `ask` input row,
// the choice buttons and `+show text` cards) plus one piece of the DOM start
// menu: the paths of its backdrop clip and still (the `menu` block below). The
// rest of the DOM UI - boot splash, preferences, save / load, pause - is styled
// by `theme.css` in the same folder as this file. Look there to change a menu's
// buttons, panels or colours, and here to swap the start menu's art.
//
// Gotchas when editing this file:
//   * Use `//` for comments. A `#` is only a comment when an identifier
//     follows it, so `#10101a` is a lexer error, not a color.
//   * Color values must therefore be quoted ("#10101a"). They also accept any
//     name from drift.model.Colors.namedColors (e.g. `aqua`, `navy`) or an
//     integer literal written as a string ("0x10101a").
//   * Split the config with `import "colors"`; imports resolve through the same
//     file handler the story scripts use.

state
	theme:
		// ---- design resolution -----------------------------------------
		// All layout is expressed in these units, on the canvas and in the
		// DOM overlay (which DomUi scales to match). The renderer scales the
		// design area to fit the window and masks off everything outside it.
		screen:
			width: 1920
			height: 1080

		// ---- start menu backdrop -----------------------------------------
		// The start menu's moving backdrop and the still shown before it (and
		// when the clip cannot play). Paths are relative to `bin/`, the same
		// root theme.css resolves against; DomUi sets them on the <video> and
		// the still behind it, so swapping the art never touches markup.
		menu:
			background: "assets/ch10/gui/main_menu.webm"
			poster: "assets/ch10/gui/main_menu.jpg"

		// ---- text roles --------------------------------------------------
		// Every role accepts `family` (omit to inherit `family` below),
		// `size` and `weight` ("bold", or omit / "normal" for regular).
		// Sizes are in design-resolution pixels, so they scale with the
		// letterboxed world like everything else.
		fonts:
			// The face ships in bin/fonts and is declared (webfont) in theme.css,
			// so it does not have to be installed; Main.hx waits for it to load
			// before the renderer builds its first text.
			family: "Source Sans 3, Segoe UI, system-ui, sans-serif"

			// Outline defaults, applied to any role that carries no `outline` of
			// its own. An outline is opt-in per role: it is there to keep text
			// readable over something busy, which the name plate and the dialogue
			// are, and is just weight on a label sitting on its own panel. The
			// width here is a share of each role's own font size, so one value
			// reads the same on a 36px dialogue line and a 75px stage title.
			outline:
				width: 0        // the default: no outline
				color: "#000000"
				join: round       // round | miter | bevel

			// dialogue
			name:
				size: 50
				weight: "bold"
				outline: 0.12   // shorthand: just the width, inheriting color / join
			body:
				size: 36
				outline: 0.12

			// The editable line of an `ask` prompt. The request itself is drawn
			// in the `body` role above it.
			dialogue:
				input:
					size: 36

			// Text drawn on a phone-chat card (`+phone`): the message bubbles,
			// the contact name in the header, and the input-bar placeholder.
			// The card is a container built from the `phone` block below, so
			// these roles set the type and the block sets the geometry.
			phone:
				message:
					size: 34
				header:
					size: 38
					weight: "bold"
				input:
					size: 30

			// Text drawn on the stage by `+show text` (a title card). Every card
			// starts from this role, and a line of a card overrides size / family /
			// weight for itself, so an author restyles all of them here and the
			// directives only carry what differs. The outline is inherited from this
			// role too - add `outline: 0.1` here if cards are read over busy art.
			stage:
				size: 98

			// Button captions: dialogue choices and the prompt's confirm button.
			button:
				size: 36

		// ---- buttons ------------------------------------------------------
		// A button sizes itself from the label role it is given (by
		// `fonts.button`): the label gets a line box of `lineHeight` x its
		// size, plus padding on each side, and a button whose width is not
		// dictated by its panel is fitted to the label. The prompt's steppers
		// keep a fixed, square size because their glyph says nothing about how
		// big they should be.
		buttons:
			minWidth: 0          // floor for a label-fitted width
			minHeight: 0
			paddingX: 24         // left and right of the label
			paddingY: 12         // above and below the label
			lineHeight: 1.4      // label line box, x the role's size
			cornerRadius: 8

		// ---- dialogue box ------------------------------------------------
		// Chrome (width / height / margin / padding / radius / nameTop /
		// nameGap) is in design pixels. Anything that has to follow the text is
		// a multiple of a font size, so bumping fonts.name.size or
		// fonts.body.size carries the text and the box with it. The height is
		// a minimum: the box grows when the line needs more room.
		dialogue:
			width: 0.6          // share of the design width
			height: 0.26        // share of the design height (minimum)
			margin: 24          // gap below the box
			padding: 24         // inner padding, left and right
			radius: 12
			nameTop: -44         // name plate from the box top; negative floats it above and shrinks the box
			nameLine: 1.2       // name line box, x fonts.name.size
			nameGap: 8          // gap between the name line and the body
			lineHeight: 1.4     // body line height, x fonts.body.size
			// How long the box takes to fade in / out when it appears or
			// disappears (a say, a title card, hiding the UI). 0 snaps.
			fade: 0.2           // seconds
			// The input row an `ask` prompt lays out under its request line. The field
			// has no box of its own - it is text on the dialogue background, set
			// flush with the request line - so these are gaps and reserved space,
			// not padding inside a frame.
			inputLine: 1.4      // input line box, x fonts.dialogue.input.size
			inputGap: 12        // gap between the prompt line and the input row
			inputPaddingX: 0    // inset from the field's left edge; 0 aligns it
			inputPaddingY: 0    // reserved space above and below the text
			inputButtonGap: 12  // gap between the field and the confirm button
			confirm: "OK"       // caption of the button that commits the field

		// ---- palette (canvas) ------------------------------------------
		colors:
			clear: "#15151c"          // letterbox / canvas clear color
			text: "#f0f0ff"           // dialogue body + button text
			name: "#8fb6ff"           // character name plates
			buttonBg: "#2a2a44"       // choice buttons
			buttonHover: "#3d3d63"
			buttonBorder: "#5a5a88"
			dialogueBg: "#101a13"
			dialogueAlpha: 0.66
			dialogueBorder: "#444466"
			inputText: "#f0f0ff"     // text typed into the prompt field
			stage: "#f0f0ff"         // `+show text` cards; a line may override it
			// Phone-chat card. Defaults are an iOS-style light thread; set these
			// to keep the phone in step with a dark theme.
			phoneScreen: "#f2f2f7"
			phoneHeaderBg: "#f7f7f9"
			phoneHeaderText: "#1c1c1e"
			phoneThem: "#e5e5ea"       // received bubble fill
			phoneThemText: "#1c1c1e"
			phoneMe: "#0a84ff"         // sent bubble fill
			phoneMeText: "#ffffff"
			phoneInputBg: "#ffffff"
			phoneInputText: "#8e8e93"  // input-bar placeholder

		// ---- stage text metrics ------------------------------------------
		// How a `+show text` card is measured on the design area. `wrap` is the
		// width its lines break at (a card is that wide even when its text is
		// narrower, which is what `at left` / `at right` place against);
		// `margin` is the inset from the design edge when a card is anchored to a
		// side or a corner - raise it above `1080 - 0.26 * 1080 - 24` if you anchor
		// a card to the bottom, which is where the dialogue box sits.
		stage:
			lineHeight: 1.25   // line box, x each line's own size
			wrap: 0.8          // share of the design width
			margin: 64         // design px from the edge

		// ---- phone card (`+phone`) ---------------------------------------
		// The chat card on the `phone` layer. `height` is a share of the design
		// height and the width follows the frame image's own aspect, so the
		// whole card scales from this one value. Everything else is either a
		// share of the card itself or a multiple of `fonts.phone.message.size`,
		// never a bare pixel count (invariant 1). The frame image is
		// `assets/shared/phone/mobile_phone.png`; a conversation's `avatar` is
		// a bare name found under `assets/shared/phone/avatars/`.
		phone:
			height: 0.94          // share of the design height
			margin: 48            // design px inset when anchored left / right
			bezel: 0.055          // frame border, share of the card's width
			headerHeight: 0.085   // header band, share of the card's height
			avatar: 0.15          // avatar diameter, share of the card's width
			bubblePad: 0.55       // bubble padding, x fonts.phone.message.size
			bubbleGap: 0.4        // gap between bubbles, x message size
			bubbleMargin: 0.05    // thread inset, share of the screen width
			bubbleMax: 0.78       // widest a bubble may grow, share of screen width
			bubbleRadius: 22      // bubble corner radius, design px
			lineHeight: 1.3       // message line box, x message size
			inputHeight: 0.07     // input bar, share of the card's height

		// ---- audio -------------------------------------------------------
		// The two sound channels and their initial volumes (0..1). The player's
		// own sliders in the preferences menu start from these and then win.
		// `musicFade` / `soundFade` are the fade lengths a bare `fadein` /
		// `fadeout` on a `+play` / `+stop` uses when no number of seconds is
		// given. Music fades over a couple of seconds; a sound effect fades
		// instantly by default, because fading a footstep is not useful.
		audio:
			music: 0.8
			sound: 1.0
			musicFade: 2.0
			soundFade: 0.0
