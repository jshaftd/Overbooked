import chapterTitleCard
import char_images
import characters
import day01

beat day00
	Möchtest du die Einführung anschauen?

	choice
		Ja gerne.
			-> tutorial
		Nein, kenn ich schon.
			-> day01

beat tutorial
	+scene bg black
	Du hörst eine angenehme Stimme direkt vor dir.

	Nur mühsam gelingt es dir, die Augen zu öffnen.

	+scene bg "0xb0b0b2"

	+show cg mika_bendover transform translate(0,-900)
	+with longdissolve
	+transform cg translate(0,900) over 4.0 ease quadinout
	
	mika.name := ???
	
	mika: Guten Morgen?
	mika: Herzlich willkommen auch an alle die gerade aufgewacht sind.
	
	Eine Frau, die wie eine Lehrerin aussieht steht vor dir.

	+transform cg translate(0,300) over 1.0 ease quadinout
	+wait click

	mika.name := Lehrerin
	mika: Nicht ablenken lassen!

	+transform cg translate(0,900) over 0.5 ease quadinout
	
	mika: Gut erkannt. Ja ich bin eine Lehrerin.
	
	+show cg mika_bendover_smile
	
	mika: Auch wenn ich keine dicke Brille trage.
	
	mika.name := Mika
	mika: Mein Name ist Mika.

	Du befindest dich in einer Art Klassenzimmer.

	+show cg mika_bendover transform translate(0,900)

	mika: Ich zeig dir sehr gerne mehr.

	+transform cg translate(0,300) over 1.0 ease quadinout
	+wait click

	mika: Ich meinte natürlich, wie das Spiel funktioniert.
	
	+transform cg translate(0,900) over 0.5 ease quadinout
	
	+wait 0.5
	+show cg mika_bendover_smile
	
	mika: Bereit?

	+scene bg classroom
	+show mika thinking
	+with dissolve

	mika: Also wo fangen wir an?
	mika: Genau. Die Steuerung.
	mika: Weiter gehts mit Links-Klick, Leertaste oder Enter.
	mika: Zum Menü gehts mit Rechts-Klick oder S.
	mika: Rollback zurück mit dem Mausrad oder bild^
	mika: Mit dem Hilfe Button im Menü kannst du nochmal alles Tastatur und Maus Kommandos nachschauen.
	mika: Wenn du neue Personen kennenlernst wird eine Charakter Karte erstellt.
	mika: Darauf siehst du die Informationen zu dieser Person.
	mika: Rechts oben auf dem Bildschirm erscheint ein Karten Symbol.
	mika: Mit Klick kannst du dir die Karten anzeigen lassen.
	+show mika listen_up
	mika: Durch Entscheidungen kannst du beeinflussen wie es weitergeht.
	mika: Manchmal beeinflusst du dabei auch was die Charaktere für dich empfinden.
	mika: Damit es übersichtlich bleibt haben wir das auf zwei Gefühle reduziert.
	+show mika thinking
	mika: Vertrauen und Attraktion
	+show mika waiting
	mika: 

	-> day01
